#!/usr/bin/env bash
# sail — search, stream, and download torrents from the terminal.
#
#   sail <query>        pick a result, then stream or download
#   sail -d <query>     download straight to ~/Downloads
#   sail -s <query>     stream in your media player
#   sail -l <query>     list results without the picker
#   sail --json <query> print results as JSON
#   sail --magnet LINK  skip the search and use a magnet link
#   sail sources        choose which sources to search
#   sail wlist [query]  launch or manage saved torrents (ctrl-x saves one)
#   sail --version      print the version and exit
#   sail -h, --help     show this help
#
# SAIL_DEBUG=1 prints each source's stderr (timeouts, parse errors) after
# a search instead of just the one-line summary, and why a subtitle already
# inside a streamed torrent (if any) failed to fetch.
#
# A macOS notification fires when a background download finishes or fails
# (SAIL_NOTIFY=0 disables it).

set -euo pipefail

# ---------- palette (plain when not attached to a terminal or NO_COLOR is
# set — https://no-color.org; layout glyphs like the progress bar stay) ------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BLD=$'\e[1m'; DIM=$'\e[2m'
    RED=$'\e[31m'; GRN=$'\e[32m'; YLW=$'\e[33m'; CYN=$'\e[36m'; RST=$'\e[0m'
else
    BLD=""; DIM=""; RED=""; GRN=""; YLW=""; CYN=""; RST=""
fi

# UTF-8 locale for the multibyte-safe width helpers (override if a machine
# lacks the macOS default)
UTF8_LOCALE="${SAIL_UTF8_LOCALE:-en_US.UTF-8}"
export UTF8_LOCALE

# bash expands ~ only in word expansion, never in a variable's value — so
# TORRENT_DOWNLOAD_DIR='~/Videos' would otherwise create a literal "~" dir
expand_tilde() {
    if [ "$1" = "~" ]; then
        printf '%s' "$HOME"
    elif [ "${1#\~/}" != "$1" ]; then
        printf '%s/%s' "$HOME" "${1#\~/}"
    else
        printf '%s' "$1"
    fi
}

SAIL_VERSION="1.5.0"
DOWNLOAD_DIR="$(expand_tilde "${SAIL_DOWNLOAD_DIR:-${TORRENT_DOWNLOAD_DIR:-$HOME/Downloads/torrents}}")"

usage() {
    cat <<'EOF'
sail — search, stream, and download torrents from the terminal.

Usage:
  sail <query>              pick a result, then stream or download
  sail -s <query>           stream the picked result immediately
  sail -d <query>           download the picked result immediately
  sail -l <query>           list results without the picker
  sail --json <query>       print results as JSON
  sail --magnet <link>      use a magnet link instead of searching
  sail sources              choose which sources every search uses
  sail wlist [query]        launch or manage saved torrents (ctrl-x saves one)
  sail --version            print the installed version
  sail -h, --help           show this help

Options may appear before or after the query:
  -s, --stream              stream the picked result immediately
  -d, --download            download the picked result immediately
  -l, --list                print seeders/size/source/title and exit
      --json                print results as JSON (implies --list)
      --magnet <link>       skip the search and use this magnet link
EOF
    exit "${1:-1}"
}

# ---- fast paths: no temp dir, no window resize, no cache cleanup ----------
case "${1:-}" in
    -v|--version)
        printf 'sail %s\n' "$SAIL_VERSION"
        exit 0 ;;
    -h|--help)
        usage 0 ;;
esac

# ---- locate lib/ next to the real script (follows the install symlink) ----
# readlink -f is not portable to older macOS, so resolve the link by hand.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    SELF_DIR="$(cd -P "$(dirname "$SELF")" >/dev/null 2>&1 && pwd)"
    SELF="$(readlink "$SELF")"
    case "$SELF" in
        /*) ;;
        *) SELF="$SELF_DIR/$SELF" ;;
    esac
done
LIB_DIR="$(cd -P "$(dirname "$SELF")/../lib" >/dev/null 2>&1 && pwd)"

# shellcheck source=../lib/wtdir.sh
. "$LIB_DIR/wtdir.sh"
# shellcheck source=../lib/wlist.sh
. "$LIB_DIR/wlist.sh"
# shellcheck source=../lib/dashboard.sh
. "$LIB_DIR/dashboard.sh"
# shellcheck source=../lib/sources-ui.sh
. "$LIB_DIR/sources-ui.sh"
# shellcheck source=../lib/wlist-ui.sh
. "$LIB_DIR/wlist-ui.sh"
# shellcheck source=../lib/torrent.sh
. "$LIB_DIR/torrent.sh"

# SIGTERM, give it a moment, then SIGKILL — webtorrent's destroy can hang
# for a very long time on unreachable trackers
stop_pid() {
    local p="$1" k
    kill "$p" 2>/dev/null || return 0
    for k in $(seq 1 10); do
        kill -0 "$p" 2>/dev/null || return 0
        sleep 0.5
    done
    kill -9 "$p" 2>/dev/null || true
}

# clear whatever the caller printed on the current line
clear_line() { printf '\r\033[K'; }

# best-effort macOS notification — never blocks or fails the caller
notify() {  # $1 = title, $2 = message
    [ "${SAIL_NOTIFY:-1}" = 1 ] || return 0
    command -v osascript >/dev/null 2>&1 || return 0
    local t m
    t="$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    m="$(printf '%s' "$2" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    osascript -e "display notification \"$m\" with title \"$t\"" >/dev/null 2>&1 || true
}

WORK="$(mktemp -d -t sail.XXXXXX)"

# clean temp files on every exit path — including Ctrl+C and closed windows.
# WT_PID, WPID and SEARCH_PID all go through stop_pid (SIGTERM, then SIGKILL
# if they don't die) — a plain kill, or no kill at all, can leave an orphaned
# webtorrent process running in the background (holding ports that then
# break the NEXT run with "address already in use") when destroy() hangs.
# Signals exit explicitly: the old shared EXIT/INT trap cleaned up and then
# let the script keep running against a deleted temp dir.
# shellcheck disable=SC2329  # invoked by the EXIT trap below
cleanup() {
    if [ -n "${RENDER_PID:-}" ]; then stop_render; fi
    [ -n "${WT_PID:-}" ] && stop_pid "$WT_PID"
    [ -n "${WPID:-}" ] && stop_pid "$WPID"
    [ -n "${SEARCH_PID:-}" ] && stop_pid "$SEARCH_PID"
    rm -rf "$WORK"
    return 0
}
# shellcheck disable=SC2329  # invoked by the INT/TERM trap below
on_signal() {
    trap - EXIT
    cleanup
    exit 130
}
trap cleanup EXIT
trap on_signal INT TERM

# no torrent data persists between runs — wipe any leftover cache from
# before this behavior existed (nothing writes here anymore, so after the
# first launch this is a no-op). After the fast paths: `sail --version`
# has no business deleting anything.
rm -rf "$HOME/.cache/sail"

# ---- grow the terminal window so results fit (never shrink) ---------------
# stty size < /dev/tty rather than tput cols: inside $( ) tput's stdout is a
# pipe, it can't ioctl the terminal, and it falls back to terminfo's 80
if [ -t 1 ]; then
    WANT_C=140; WANT_R=42
    CUR_C="$(stty size < /dev/tty 2>/dev/null | cut -d' ' -f2 || true)"
    CUR_R="$(stty size < /dev/tty 2>/dev/null | cut -d' ' -f1 || true)"
    if [ "${CUR_C:-0}" -lt "$WANT_C" ] || [ "${CUR_R:-0}" -lt "$WANT_R" ]; then
        NEW_C=$(( CUR_C > WANT_C ? CUR_C : WANT_C ))
        NEW_R=$(( CUR_R > WANT_R ? CUR_R : WANT_R ))
        printf '\e[8;%d;%dt' "$NEW_R" "$NEW_C"
        sleep 0.15
    fi
fi

# ---- `sail sources` — choose which sources every search uses --------------
if [ "${1:-}" = "sources" ]; then
    CONF="$(expand_tilde "${SAIL_SOURCES:-$HOME/.config/sail/sources.conf}")"
    sail_sources_ui "$CONF"
    exit 0
fi

# ---- `sail wlist [query]` — launch or manage the watchlist ----------------
SKIP_SEARCH=0
if [ "${1:-}" = "wlist" ]; then
    shift
    command -v wlist_add >/dev/null 2>&1 \
        || { printf '  sail is missing lib/wlist.sh — reinstall sail\n' >&2; exit 1; }
    if sail_wlist_ui "$*"; then
        SKIP_SEARCH=1
        set --   # the wlist query is consumed; don't parse it as sail options
    else
        exit 0
    fi
fi

# ---- options and query ----------------------------------------------------
MODE="ask"
LIST_MODE=0
JSON_MODE=0
MAGNET=""
QUERY=""

while [ $# -gt 0 ]; do
    case "$1" in
        -s|--stream) MODE="stream" ;;
        -d|--download) MODE="download" ;;
        -l|--list) LIST_MODE=1 ;;
        --json) JSON_MODE=1; LIST_MODE=1 ;;
        -v|--version)
            printf 'sail %s\n' "$SAIL_VERSION"
            exit 0 ;;
        -h|--help) usage 0 ;;
        --magnet)
            shift
            [ $# -ge 1 ] || usage
            MAGNET="$1" ;;
        --magnet=*) MAGNET="${1#*=}" ;;
        --)
            shift
            while [ $# -gt 0 ]; do
                QUERY="${QUERY:+$QUERY }$1"
                shift
            done
            break ;;
        -*)
            printf 'sail: unknown option: %s\n' "$1" >&2
            usage ;;
        *)
            QUERY="${QUERY:+$QUERY }$1" ;;
    esac
    shift
done

if [ -n "$MAGNET" ]; then
    case "$MAGNET" in
        magnet:?*)
            [ -n "$QUERY" ] && usage
            SKIP_SEARCH=1
            # the display name is the magnet's dn= parameter, when present
            SEL_TITLE="$(python3 - "$MAGNET" <<'PY' 2>/dev/null || true
import sys, urllib.parse
q = urllib.parse.parse_qs(urllib.parse.urlsplit(sys.argv[1]).query)
print((q.get("dn") or ["magnet link"])[0])
PY
)"
            [ -n "$SEL_TITLE" ] || SEL_TITLE="magnet link" ;;
        *)
            printf 'sail: that is not a magnet link: %s\n' "$MAGNET" >&2
            usage ;;
    esac
fi

if [ "$SKIP_SEARCH" != 1 ]; then
    [ -n "$QUERY" ] || usage
    # `sail ""` passed the arg count but searched for nothing; treat it as
    # missing input rather than printing "no results for "
    case "$QUERY" in
        *[![:space:]]*) ;;
        *) usage ;;
    esac
fi

SEL_TITLE="${SEL_TITLE:-}"

# braille spinner, shared by the search/meta phases and the live dashboard
SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)

# ---- search ---------------------------------------------------------------

# run search.py with a spinner on stderr (keeps stdout clean for -l/--json).
# returns search.py's status: 0 ok, 2 every source failed, 3 none enabled.
sail_search() {  # $1 = query, $2 = output file, $3 = 1 for JSON
    local query="$1" out="$2" as_json="${3:-0}" rc=0 i=0
    if [ "$as_json" = 1 ]; then
        python3 "$LIB_DIR/search.py" --json "$query" > "$out" 2>"$WORK/search.err" &
    else
        python3 "$LIB_DIR/search.py" "$query" > "$out" 2>"$WORK/search.err" &
    fi
    SEARCH_PID=$!
    while kill -0 "$SEARCH_PID" 2>/dev/null; do
        # a redirected stderr gets plain text, not a stream of braille/backspaces
        if [ -t 2 ]; then
            printf '%s%s%s\b' "$CYN" "${SPIN[$((i % 10))]}" "$RST" >&2
        fi
        i=$((i + 1))
        sleep 0.25
    done
    wait "$SEARCH_PID" || rc=$?
    SEARCH_PID=""
    if [ -t 2 ]; then clear_line >&2; fi
    return "$rc"
}

# per-source errors in debug mode; a single summary line otherwise
sail_search_report() {
    [ -s "$WORK/search.err" ] || return 0
    if [ "${SAIL_DEBUG:-0}" = 1 ]; then
        printf '  %sdebug:%s\n' "$DIM" "$RST" >&2
        sed 's/^/    /' "$WORK/search.err" >&2
    else
        grep '^\[sources\]' "$WORK/search.err" 2>/dev/null \
            | while IFS= read -r line; do
                  printf '  %s%s%s\n' "$DIM" "$line" "$RST" >&2
              done
    fi
}

sail_search_failed() {  # $1 = rc, $2 = query
    case "$1" in
        3) printf '  %sno sources enabled%s — run: %ssail sources%s\n' \
               "$BLD" "$RST" "$CYN" "$RST" >&2 ;;
        2) printf '  %scouldn'"'"'t reach any source%s — check your connection%s\n' \
               "$BLD" "$RST" \
               "$([ "${SAIL_DEBUG:-0}" = 1 ] && printf ' (see the source errors above)')" >&2 ;;
        *) printf '  no results for %s%s%s\n' "$BLD" "$2" "$RST" >&2
           printf '  %stry fewer words, or add sources: sail sources%s\n' "$DIM" "$RST" >&2 ;;
    esac
}

# ---- results list ---------------------------------------------------------

# sorted_results <file> <seed|size|age> — same rows, different order; the
# id column stays intact, so the caller's lookups by id keep working
sorted_results() {
    case "$2" in
        size)
            awk -F'\t' '
                function bytes(s,   n, u) {
                    if (s == "?" || s == "") return -1
                    n = s + 0
                    u = s; sub(/^[0-9.]+[ ]*/, "", u); sub(/B$/, "", u)
                    if (u == "K") return n * 1024
                    if (u == "M") return n * 1048576
                    if (u == "G") return n * 1073741824
                    if (u == "T") return n * 1099511627776
                    return n
                }
                { printf "%d\t%s\n", bytes($3), $0 }' "$1" \
                | sort -t "$(printf '\t')" -k1,1nr \
                | cut -f2- ;;
        age)
            awk -F'\t' '
                function secs(s,   n, u) {
                    if (s == "?" || s == "") return 1e18
                    if (s == "just now") return 0
                    n = s + 0
                    u = s; sub(/^[0-9]+/, "", u); sub(/ ago$/, "", u)
                    if (u == "m") return n * 60
                    if (u == "h") return n * 3600
                    if (u == "d") return n * 86400
                    if (u == "mo") return n * 2592000
                    if (u == "y") return n * 31536000
                    return 1e18
                }
                { printf "%d\t%s\n", secs($6), $0 }' "$1" \
                | sort -t "$(printf '\t')" -k1,1n \
                | cut -f2- ;;
        *)
            sort -t "$(printf '\t')" -k2,2nr "$1" ;;
    esac
}

# print results as a plain table (no picker) — for `sail -l`
list_results() {
    awk -F'\t' '{ printf "%6s  %-9s %-6s %s\n", $2, $3, $4, $5 }' "$1"
}

sort_label() {
    case "$1" in
        size) printf 'size' ;;
        age)  printf 'newest' ;;
        *)    printf 'seeders' ;;
    esac
}

next_sort() {
    case "$1" in
        seed) printf 'size' ;;
        size) printf 'age' ;;
        *)    printf 'seed' ;;
    esac
}

# ---- 1. search + 2. pick --------------------------------------------------
search_and_pick() {
    printf '  searching for %s%s%s ' "$CYN" "$QUERY" "$RST" >&2
    local rc=0 n_results
    sail_search "$QUERY" "$WORK/results" || rc=$?
    sail_search_report

    if [ ! -s "$WORK/results" ]; then
        sail_search_failed "$rc" "$QUERY"
        exit 1
    fi

    n_results=$(wc -l < "$WORK/results" | tr -d ' ')
    printf '  %s%s results%s\n\n' "$BLD" "$n_results" "$RST" >&2

    # ---- 2. pick a torrent — ctrl-x saves one, ctrl-t re-sorts ------------
    # --expect makes fzf print the pressed key ahead of the selection, which
    # is how ctrl-x/ctrl-t are told apart from plain enter; the loop redraws
    # the list after a save, so several torrents can be watchlisted in one
    # pass (cmd+x would read better but terminals swallow it for their Edit
    # menu — CLI apps never see it)
    local NOTICE="" SORT_MODE="seed" OUT PICK_KEY LINE
    while :; do
        # rows are tab-delimited so fzf can hide the internal row id from the
        # display (--with-nth) while the selection still carries it in field
        # 1 — same trick pick_video uses. Fields keep fixed widths (seed %-5s,
        # size %-9s, src %-6s); the displayed line is the selected fields
        # joined by a single column, and the header below is padded so each
        # word starts at the column its field starts at (verified in a pty:
        # header and row words land on identical columns)
        OUT="$(sorted_results "$WORK/results" "$SORT_MODE" \
            | awk -F'\t' -v R="$RST" -v D="$DIM" \
            -v G="$GRN" -v Y="$YLW" -v Rd="$RED" -v C="$CYN" -v B="$BLD" '{
            id=$1; seed=$2+0; size=$3; src=$4; title=$5; age=$6
            if (seed >= 50)      sc = G
            else if (seed >= 10) sc = Y
            else                 sc = Rd
            agecol = ""
            if (age != "?") agecol = sprintf("%s  (%s)%s", D, age, R)
            printf "%s\t%s%-5s%s\t%-9s\t%-6s\t%s%s%s\t%s\n", \
                id, sc, seed, R, size, src, B, title, R, agecol
        }' | fzf --ansi --expect=ctrl-x,ctrl-t \
              --delimiter='\t' --with-nth=2,3,4,5,6 \
              --header="seed  size      source title"$'\n'"  enter: select   ctrl-x: watchlist   ctrl-t: sort ($(sort_label "$SORT_MODE"))   esc: cancel$NOTICE" \
              --header-first --reverse --height=90% --tabstop=1 \
              --border=rounded --margin=1,2)" || exit 0
        PICK_KEY="${OUT%%$'\n'*}"
        LINE="$(printf '%s' "$OUT" | sed -n '2p')"

        case "$PICK_KEY" in
            *ctrl-t*)
                SORT_MODE="$(next_sort "$SORT_MODE")"
                NOTICE=""
                continue ;;
        esac

        if [ "$PICK_KEY" = "ctrl-x" ]; then
            local PLAINX XID XTITLE XMAGNET SAVED_MAGNET SAVE_NOTE RESOLVED
            PLAINX="$(printf '%s' "$LINE" | sed $'s/\x1b\\[[0-9;]*m//g')"
            XID="$(printf '%s\n' "$PLAINX" | cut -f1)"
            XTITLE="$(awk -F'\t' -v id="$XID" '$1 == id { print $5; exit }' "$WORK/results")"
            XMAGNET="$(awk -F'\t' -v id="$XID" '$1 == id { print $7; exit }' "$WORK/results")"
            if [ -n "$XTITLE" ] && [ -n "$XMAGNET" ]; then
                SAVED_MAGNET="$XMAGNET"
                SAVE_NOTE=""
                # scraped sources only have a detail-page URL at save time;
                # resolving it now keeps the saved entry usable after the
                # search page is gone (and dedupes it against magnets saved
                # from other sources)
                if [[ "$SAVED_MAGNET" == FETCH:* ]]; then
                    if RESOLVED="$(resolve_magnet "${SAVED_MAGNET#FETCH:}")"; then
                        SAVED_MAGNET="$RESOLVED"
                    else
                        SAVE_NOTE=" (link unresolved)"
                    fi
                fi
                if wlist_add "$XTITLE" "$SAVED_MAGNET"; then
                    NOTICE=$'\n\n'"  saved to watchlist: $XTITLE$SAVE_NOTE"
                else
                    NOTICE=$'\n\n'"  already watchlisted (moved to top): $XTITLE$SAVE_NOTE"
                fi
            fi
            continue
        fi
        break
    done

    [ -n "$LINE" ] || exit 0

    local PLAIN SEL_ID
    PLAIN="$(printf '%s' "$LINE" | sed $'s/\x1b\\[[0-9;]*m//g')"
    SEL_ID="$(printf '%s\n' "$PLAIN" | cut -f1)"
    SEL_TITLE="$(awk -F'\t' -v id="$SEL_ID" '$1 == id { print $5; exit }' "$WORK/results")"
    MAGNET="$(awk -F'\t' -v id="$SEL_ID" '$1 == id { print $7; exit }' "$WORK/results")"
}

# resolve a scraped source's detail page into a magnet. stderr goes to a
# file so a failure reads as one line, not a Python traceback.
resolve_magnet() {
    python3 - "$LIB_DIR" "$1" <<'PY' 2>"$WORK/resolve.err"
import sys
sys.path.insert(0, sys.argv[1])
from search import magnet_from_detail
print(magnet_from_detail(sys.argv[2]))
PY
}

# ---- list / JSON modes ----------------------------------------------------
if [ "$LIST_MODE" = 1 ]; then
    # `--magnet ... -l/--json` has no search results to list — print the
    # link itself so the flags are not silently ignored
    if [ "$SKIP_SEARCH" = 1 ]; then
        if [ "$JSON_MODE" = 1 ]; then
            python3 -c 'import json, sys
print(json.dumps([{"id": "0", "seeders": "", "size": "", "source": "magnet",
                   "title": sys.argv[1], "age": "", "magnet": sys.argv[2]}],
                 indent=2, ensure_ascii=False))' "$SEL_TITLE" "$MAGNET"
        else
            printf '%s\t%s\n' "$SEL_TITLE" "$MAGNET"
        fi
        exit 0
    fi

    printf '  searching for %s%s%s ' "$CYN" "$QUERY" "$RST" >&2
    RC=0
    if [ "$JSON_MODE" = 1 ]; then
        sail_search "$QUERY" "$WORK/results.json" 1 || RC=$?
    else
        sail_search "$QUERY" "$WORK/results" 0 || RC=$?
    fi
    sail_search_report

    if [ "$RC" -ne 0 ]; then
        sail_search_failed "$RC" "$QUERY"
        exit "$RC"
    fi
    if [ "$JSON_MODE" = 1 ]; then
        cat "$WORK/results.json"
    elif [ -s "$WORK/results" ]; then
        list_results "$WORK/results"
    else
        sail_search_failed 0 "$QUERY"
        exit 1
    fi
    exit 0
fi

if [ "$SKIP_SEARCH" != 1 ]; then
    search_and_pick
fi

# ---- resolve a scraped detail-page URL ------------------------------------
if [[ "$MAGNET" == FETCH:* ]]; then
    printf '  resolving magnet link…\n'
    if RESOLVED="$(resolve_magnet "${MAGNET#FETCH:}")"; then
        MAGNET="$RESOLVED"
    else
        printf '  %scouldn'"'"'t resolve the magnet link%s — the source page is unavailable\n' \
            "$RED" "$RST" >&2
        if [ "${SAIL_DEBUG:-0}" = 1 ] && [ -s "$WORK/resolve.err" ]; then
            sed 's/^/    /' "$WORK/resolve.err" >&2
        fi
        exit 1
    fi
fi

# options for the wt.js torrent runner: the magnet's trackers (the cached
# .torrent only carries the source site's announce list — often udp-only —
# while the magnet includes the websocket trackers that actually reach
# peers) plus free ports for the torrent and dht sockets
OPTS_JSON="$(printf '%s' "$MAGNET" | tr '&' '\n' | sed -n 's/^tr=//p' | python3 -c '
import sys, urllib.parse, json, socket
announce = [urllib.parse.unquote(x.strip()) for x in sys.stdin if x.strip()]
ports = []
for _ in range(2):
    s = socket.socket(); s.bind(("", 0)); ports.append(s.getsockname()[1]); s.close()
print(json.dumps({"announce": announce, "torrentPort": ports[0], "dhtPort": ports[1]}))')"

# locate the webtorrent node module — wt.js drives it directly because
# webtorrent-cli's --select downloads the whole torrent (broken so).
# SAIL_WTMOD overrides; otherwise walk up from the webtorrent binary.
WTMOD="${SAIL_WTMOD:-}"
[ -n "$WTMOD" ] || WTMOD="$(find_webtorrent_module)"

# repair a known-broken webtorrent before first use: 2.8.5 (what
# webtorrent-cli 6.x installs) crashes on every torrent add when its
# uint8-util dependency resolves to >=2.3 — no-op (one grep) on healthy
# installs, self-resolves when WTMOD is empty; || true because a stale
# ~/.sail install may not have the script yet — never block sailing on it
bash "$LIB_DIR/fix-webtorrent.sh" "$WTMOD" || true

# ---- 3. stream or download ------------------------------------------------
if [ "$MODE" = "ask" ]; then
    printf '\n  %s%s%s\n' "$BLD" "$SEL_TITLE" "$RST"
    printf '  stream or download? [S/d/q] '
    answer=""
    read -r answer || true
    case "$answer" in
        d|D) MODE="download"; ASK_DIR=1 ;;
        q|Q) exit 0 ;;
        *)   MODE="stream" ;;
    esac
fi

if [ "$MODE" = "download" ]; then
    mkdir -p "$DOWNLOAD_DIR"
    if [ "${ASK_DIR:-0}" = 1 ]; then
        printf '  choose a folder in the picker (cancel = %s%s%s)\n' \
            "$CYN" "$DOWNLOAD_DIR" "$RST"
        PICKED="$(sail_pick_folder "$DOWNLOAD_DIR")"
        if [ -n "$PICKED" ]; then
            DOWNLOAD_DIR="${PICKED%/}"
            [ -n "$DOWNLOAD_DIR" ] || DOWNLOAD_DIR="/"   # picked the volume root
            mkdir -p "$DOWNLOAD_DIR"
        fi
    fi
fi

# metadata is fetched fresh every time — nothing is cached to disk
sail_read_meta "$MAGNET"
sail_videos

RC=0
if [ "$MODE" = "stream" ]; then
    sail_stream "$MAGNET" "$META" "$SEL_TITLE" || RC=$?
else
    sail_download "$MAGNET" "$META" "$SEL_TITLE" "$DOWNLOAD_DIR" || RC=$?
fi
exit "$RC"
