#compdef sail
# sail zsh completion.
#
# Copy this file (as "_sail") onto a directory in your $fpath, e.g.
# "$(brew --prefix)/share/zsh/site-functions/", then start a new shell.

_arguments -s \
    '(-s --stream -d --download)'{-s,--stream}'[stream the picked result immediately]' \
    '(-s --stream -d --download)'{-d,--download}'[download the picked result immediately]' \
    '(-l --list --json)'{-l,--list}'[list results without the picker]' \
    '--json[print results as JSON]' \
    '--magnet[skip the search and use this magnet link]:magnet link:' \
    '(-h --help)'{-h,--help}'[show usage]' \
    '(-v --version)'{-v,--version}'[print the version]' \
    '1:command or query:(sources wlist)' \
    '*:query:'
